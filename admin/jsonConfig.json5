{
	"type": "tabs",
	"i18n": true,
	"items": {

		//https://github.com/ioBroker/json-config#common-control-elements
		"tab-main": {
			"type": "panel",
			"label": "Main settings",
			"items": {
				"readCronString": {
					"newLine": true,
					"type": "cron",
					"label": "readCronString",
					"help": "readCronString_help",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4
				},

				"timezone": {
					"type": "text",
					"newLine": true,
					"text": "timezone",
					"label": "timezone",
					"help": "timezone_help",
					"default": "Europe/Berlin",
					"xs": 12,
					"sm": 2,
					"md": 2,
					"lg": 2,
					"xl": 2
				}
			}

		},

		"tab-search": {
			"type": "panel",
			"label": "Search settings",
			"items": {
				"serpApiHdr": {
					"type": "staticText",
					"newLine": true,
					"text": "Google Search API",
					"xs": 12,
					"sm": 2,
					"md": 2,
					"lg": 2,
					"xl": 2
				},

				"serpApiHint": {
					"type": "staticText",
					"newLine": true,
					"text": "Google Search API is used to search the web. You need a personal API key.",
					"xs": 12,
					"sm": 2,
					"md": 2,
					"lg": 2,
					"xl": 2
				},

				"serpApiLink": {
					"type": "staticLink",
					"text": "link to Google Search API",
					"href": "https://serpapi.com/dashboard",
					"button": true,
					"icon": "info",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},


				"dividerHdr1": {
					"newLine": true,
					"type": "header",
					"text": "configuration",
					"size": 2
				},

				"SerpApi_enabled": {
					"type": "checkbox",
					"newLine": true,
					"label": "enabled",
					"tooltip": "enable search via SerpAPI",
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"SerpApi_key": {
					"type": "password",
					"newLine": true,
					"label": "SerpApi key",
					"help": "SerpApi_key_help",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"SerpApi_SearchString": {
					"type": "text",
					"newLine": true,
					"minRows": 5,
					"label": "SerpApi Search String",
					"help": "describe what you search",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				}
			}
		},
		"tab-AI": {
			"type": "panel",
			"label": "AI settings",
			"items": {

				"geminiApiHdr": {
					"type": "staticText",
					"newLine": true,
					"text": "Google Gemini API",
					"xs": 12,
					"sm": 2,
					"md": 2,
					"lg": 2,
					"xl": 2
				},

				"geminiApiHint": {
					"type": "staticText",
					"newLine": true,
					"text": "Google Gemini API is used to further process search results. You need a personal API key.",
					"xs": 12,
					"sm": 2,
					"md": 2,
					"lg": 2,
					"xl": 2
				},

				"geminiApiLink": {
					"type": "staticLink",
					"text": "link to Google Gemini API",
					"href": "https://ai.google.dev/api/interactions-api?hl=de",
					"button": true,
					"icon": "info",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},


				"dividerHdr2": {
					"newLine": true,
					"type": "header",
					"text": "configuration",
					"size": 2
				},


				"GeminiApi_enabled": {
					"type": "checkbox",
					"label": "enabled",
					"tooltip": "enable search via Gemini API",
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"GeminiApi_key": {
					"type": "password",
					"newLine": true,
					"label": "GeminiApi key",
					"help": "your personal GeminiAPI key",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"GeminiApi_SearchString": {
					"type": "text",
					"newLine": true,
					"minRows": 5,
					"label": "GeminiApi Search String",
					"help": "describe what you search. Search Results will be added automatically if present",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				}
			}
		}
	}
}
